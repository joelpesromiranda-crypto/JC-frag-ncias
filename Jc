<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JC Fragrâncias - Perfumes Masculinos Luxuosos</title>
    <style>
        :root {
            --cor-fundo: #09090b; /* Preto quase puro */
            --cor-principal: #18181b; /* Cinza muito escuro para contraste */
            --cor-ouro: #cda24e; /* Dourado elegante do logo */
            --cor-ouro-brilho: #f3d08c;
            --cor-texto: #e4e4e7;
            --cor-texto-escuro: #18181b;
        }

        body {
            font-family: 'Times New Roman', Times, serif; /* Fonte clássica para luxo */
            background-color: var(--cor-fundo);
            color: var(--cor-texto);
            margin: 0;
            padding: 0;
        }

        header {
            background-color: var(--cor-principal);
            text-align: center;
            padding: 50px 20px;
            border-bottom: 2px solid var(--cor-ouro);
        }

        .logo-placeholder {
            font-size: 3rem;
            font-weight: bold;
            color: var(--cor-ouro);
            letter-spacing: 5px;
            text-transform: uppercase;
            margin: 0;
            text-shadow: 0 2px 10px rgba(205, 162, 78, 0.4);
        }

        .sub-logo {
            color: #71717a;
            font-size: 1rem;
            margin-top: 10px;
            font-family: 'Helvetica', sans-serif;
        }

        .main-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .catalogo-title {
            text-align: center;
            margin-bottom: 50px;
            font-size: 2.2rem;
            color: var(--cor-texto);
        }

        .catalogo-title span {
            color: var(--cor-ouro);
        }

        .grid-perfumes {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .card-perfume {
            background-color: var(--cor-principal);
            border: 1px solid #27272a;
            border-radius: 8px;
            padding: 25px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .card-perfume:hover {
            border-color: var(--cor-ouro);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .image-box {
            width: 100%;
            height: 250px;
            background-color: #27272a;
            border-radius: 6px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #52525b;
            font-family: sans-serif;
            font-size: 0.9rem;
        }

        .label-marca {
            color: var(--cor-ouro);
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 2px;
            margin-bottom: 5px;
            font-family: sans-serif;
        }

        .nome-perfume {
            font-size: 1.5rem;
            margin: 0 0 15px 0;
            color: var(--cor-texto);
        }

        .preco-box {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--cor-ouro-brilho);
            margin-bottom: 20px;
        }

        .moeda {
            font-size: 1rem;
            color: #a1a1aa;
        }

        .btn-contacto {
            display: block;
            background-color: var(--cor-ouro);
            color: var(--cor-texto-escuro);
            text-decoration: none;
            padding: 15px;
            border-radius: 4px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: background-color 0.3s;
            font-family: sans-serif;
        }

        .btn-contacto:hover {
            background-color: var(--cor-ouro-brilho);
        }

        /* Botão Flutuante */
        .wpp-float {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #25d366;
            color: white;
            padding: 18px 25px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1000;
            font-family: sans-serif;
        }

        footer {
            background-color: var(--cor-principal);
            text-align: center;
            padding: 30px;
            border-top: 1px solid #27272a;
            color: #71717a;
            font-size: 0.9rem;
            margin-top: 50px;
            font-family: sans-serif;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-placeholder">JC FRAGRÂNCIAS</div>
        <div class="sub-logo">A essência do homem moderno e audaz. Luanda - Angola.</div>
    </header>

    <div class="main-container">
        <h2 class="catalogo-title">Coleção <span>Elegance</span></h2>

        <div class="grid-perfumes">
            <div class="card-perfume">
                <div class="image-box">FOTO: L'HOMME (PRETO)</div>
                <div class="label-marca">JC Fragrâncias</div>
                <h3 class="nome-perfume">L'Homme Noir</h3>
                <div class="preco-box">1.500 <span class="moeda">KZ AO</span></div>
                <a href="https://wa.me/244931887596?text=Olá JC! Tenho interesse no perfume L'Homme Noir." target="_blank" class="btn-contacto">Encomendar</a>
            </div>

            <div class="card-perfume">
                <div class="image-box">FOTO: LE PARFUM (OURO)</div>
                <div class="label-marca">JC Fragrâncias</div>
                <h3 class="nome-perfume">Le Parfum Doré</h3>
                <div class="preco-box">1.500 <span class="moeda">KZ AO</span></div>
                <a href="https://wa.me/244931887596?text=Olá JC! Tenho interesse no perfume Le Parfum Doré." target="_blank" class="btn-contacto">Encomendar</a>
            </div>

            <div class="card-perfume">
                <div class="image-box">FOTO: LA NUIT (AZUL)</div>
                <div class="label-marca">JC Fragrâncias</div>
                <h3 class="nome-perfume">La Nuit Bleue</h3>
                <div class="preco-box">1.500 <span class="moeda">KZ AO</span></div>
                <a href="https://wa.me/244931887596?text=Olá JC! Tenho interesse no perfume La Nuit Bleue." target="_blank" class="btn-contacto">Encomendar</a>
            </div>
        </div>
    </div>

    <a href="tel:931887596" class="wpp-float">
        📞 LIGAR: 931 887 596
    </a>

    <footer>
        <p>&copy; 2024 JC Fragrâncias. Todos os direitos reservados.</p>
        <p>A sua perfumaria de confiança em Angola.</p>
    </footer>

</body>
</html>
